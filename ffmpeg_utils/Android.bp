cc_library_shared {
    name: "libffmpeg_utils",
    vendor: true,
    export_include_dirs: [
        ".",
    ],
    srcs: [
        "ffmpeg_hwaccel.c",
        "ffmpeg_utils.cpp",
    ],
    shared_libs: [
        "libavcodec",
        "libavformat",
        "libavutil",
        "libcutils",
        "liblog",
        "libswresample",
        "libswscale",
        "libutils",
    ],
}
